<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3"/>
<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
<SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
<SolidColorBrush x:Key="MutedBrush" Color="#616161"/>
<SolidColorBrush x:Key="AccentBrush" Color="#1687F8"/>
<SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="ButtonBrush" Color="#F9F9F9"/>
<SolidColorBrush x:Key="HoverBrush" Color="#E9E9E9"/>
<SolidColorBrush x:Key="SelectionBrush" Color="#E8F3FF"/>
<CornerRadius x:Key="CardRadius">8</CornerRadius>
<CornerRadius x:Key="ButtonRadius">4</CornerRadius>
<FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Malgun Gothic</FontFamily>
<FontFamily x:Key="MetadataFont">Segoe UI, Malgun Gothic</FontFamily>
<FontWeight x:Key="HeadingWeight">SemiBold</FontWeight>
<Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
</ResourceDictionary>
