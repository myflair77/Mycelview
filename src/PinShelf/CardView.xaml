<UserControl x:Class="PinShelf.CardView" AllowDrop="True" PreviewDragEnter="FileTransferOver" PreviewDragOver="FileTransferOver" PreviewDragLeave="FileTransferLeave" PreviewDrop="FileTransferDrop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalAlignment="Stretch" Height="{Binding DisplayHeight}" FontSize="{DynamicResource FontSize11}">
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="{DynamicResource CardHeaderHeight}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="CardHeader" Background="Transparent" Margin="8,4,6,3">
    <Grid.RowDefinitions><RowDefinition Height="{DynamicResource CardTitleHeight}"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <Border x:Name="EnlargeHotspot" Panel.ZIndex="10" Grid.Column="2" Grid.RowSpan="2" Width="44" HorizontalAlignment="Right" Background="{DynamicResource SelectionBrush}" BorderThickness="0" Margin="0,0,0,6" CornerRadius="5" ToolTip="여기에 마우스를 올리면 카드가 확대됩니다" MouseEnter="HeaderHoverEnter" MouseMove="HeaderHoverEnter" MouseLeave="HeaderHoverLeave" AutomationProperties.Name="카드 확대 반응 영역">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
      <Path x:Name="EnlargeHotspotIcon" Width="17" Height="17" Stretch="Uniform" Stroke="#858585" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,6 L1,1 M1,5 L1,1 L5,1 M10,10 L15,15 M11,15 L15,15 L15,11 M10,6 L15,1 M11,1 L15,1 L15,5 M6,10 L1,15 M1,11 L1,15 L5,15"/>
      <TextBlock x:Name="EnlargeHotspotLabel" Text="확대" FontSize="9" Foreground="#858585" HorizontalAlignment="Center" Margin="0,2,0,0"/>
     </StackPanel>    </Border>    <TextBlock x:Name="ReorderGrip" Text="⠿" FontSize="17" Cursor="SizeAll" VerticalAlignment="Center" ToolTip="드래그하여 폴더 순서 변경" PreviewMouseLeftButtonDown="CardReorderStart"/>
    <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize12}" FontWeight="{DynamicResource HeadingWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="2,0,8,0"/>
     <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontFamily="{DynamicResource MetadataFont}" FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" VerticalAlignment="Center"/>
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#595959"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2.5,0"/><Setter Property="Width" Value="20"/><Setter Property="Height" Value="22"/></Style></StackPanel.Resources>
     <Button Command="{Binding Back}" ToolTip="뒤로" AutomationProperties.Name="뒤로"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M15,8 L1,8 M7,2 L1,8 L7,14"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button><Button Command="{Binding Forward}" ToolTip="앞으로" AutomationProperties.Name="앞으로"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,8 L15,8 M9,2 L15,8 L9,14"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button><Button Command="{Binding Up}" ToolTip="상위 폴더" AutomationProperties.Name="상위 폴더"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.875" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8,15 L8,1 M2,7 L8,1 L14,7"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button><Button Command="{Binding Reload}" ToolTip="새로고침" AutomationProperties.Name="새로고침"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M14,5 A6.5,6.5 0 1 0 14,11 M14,1 L14,6 L9,6"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button><Button Command="{Binding Home}" ToolTip="원래 위치로" AutomationProperties.Name="원래 위치로"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,8 L8,1 L15,8 M3,6 L3,15 L13,15 L13,6 M6,15 L6,10 L10,10 L10,15"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button>
     <Button x:Name="NewFolderButton" Click="CreateFolder" ToolTip="새 폴더 만들기" AutomationProperties.Name="새 폴더 만들기"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,4 L1,14 L15,14 L15,4 L8,4 L6,2 L1,2 Z M8,6 L8,12 M5,9 L11,9"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button>
     <Button x:Name="CollapseButton" Command="{Binding Collapse}" ToolTip="접기 / 펼치기" AutomationProperties.Name="접기 / 펼치기"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M5,1 L12,8 L5,15"/><Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="Data" Value="M1,5 L8,12 L15,5"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
     <Button x:Name="NoteButton" ToolTip="메모 · 클릭하면 편집" AutomationProperties.Name="메모 · 클릭하면 편집" Click="ToggleNotePopup" MouseEnter="OpenNotePopup" MouseLeave="LeaveNotePopup"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M2,12 L12,2 L16,6 L6,16 L1,17 Z M10,4 L14,8 M2,12 L6,16"><Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.LayoutTransform></Path></Button>
     <Button Click="ShowMenu" ToolTip="카드 메뉴" AutomationProperties.Name="카드 메뉴"><Canvas Width="14" Height="14"><Canvas.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Canvas.LayoutTransform><Ellipse Width="2" Height="2" Canvas.Left="1" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Ellipse Width="2" Height="2" Canvas.Left="6" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Ellipse Width="2" Height="2" Canvas.Left="11" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas><Button.ContextMenu><ContextMenu><MenuItem Header="전체 경로 복사" Command="{Binding CopyPath}"/><MenuItem Header="Windows에서 열기" Command="{Binding OpenExternal}"/><MenuItem Header="경로 재연결…" Click="Reconnect"/><Separator/><MenuItem Header="카드 복제" Click="Duplicate"/><MenuItem Header="카드 등록 해제 (원본 유지)" Click="Remove"/></ContextMenu></Button.ContextMenu></Button>
    </StackPanel>
    <Popup x:Name="NotePopup" PlacementTarget="{Binding ElementName=NoteButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Closed="NotePopupClosed">
     <Border x:Name="NoteSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" PreviewMouseLeftButtonDown="EditNoteSurface" MouseEnter="OpenNotePopup" MouseLeave="LeaveNotePopup">
      <StackPanel Width="260"><TextBlock Text="폴더 메모" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="NoteEditor" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" ToolTip="자동으로 저장됩니다" GotKeyboardFocus="PinNotePopup"/><TextBlock Text="실시간 저장됩니다" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Opacity="0.65" FontSize="{DynamicResource FontSize10}" Margin="0,6,0,0"/></StackPanel>
     </Border>
    </Popup>
   </Grid>
   <Grid x:Name="FolderBody" Grid.Row="1" Visibility="{Binding Expanded, Converter={StaticResource BoolVisibility}}" Margin="8,0,8,6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="1">
     <DataGrid x:Name="FileList" PreviewMouseLeftButtonDown="FileDragMouseDown" PreviewMouseLeftButtonUp="FileDragMouseUp" PreviewMouseMove="FileDragMouseMove" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" RowHeight="{DynamicResource FileRowHeight}" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="OpenEntry" KeyDown="EntryKeyDown" Sorting="SortEntries" Loaded="ListLoaded" ScrollViewer.ScrollChanged="ListScrolled" Visibility="{Binding IsFolder, Converter={StaticResource BoolVisibility}}">
      <DataGrid.Resources>
       <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="6,2"/><Setter Property="BorderThickness" Value="0,0,1,0"/></Style>
       <Style x:Key="FileColumnText" TargetType="TextBlock"><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="이름" SortMemberPath="Name" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding IconImage}" Width="16" Height="16" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Grid.Column="1" Tag="FileName" Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBox x:Name="InlineNameEditor" Grid.Column="1" Visibility="Collapsed" Padding="1,0" Margin="0" VerticalContentAlignment="Center" KeyDown="InlineRenameKeyDown" LostKeyboardFocus="InlineRenameLostFocus"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn x:Name="ModifiedColumn" ElementStyle="{StaticResource FileColumnText}" Header="수정한 날짜" Binding="{Binding Modified, StringFormat=yy.MM.dd HH:mm}" SortMemberPath="Modified" Width="Auto"/>
       <DataGridTextColumn x:Name="SizeColumn" Header="크기" Binding="{Binding Size}" SortMemberPath="Length" Width="Auto" MinWidth="36"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.HeaderStyle><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource FileColumnText}"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
<DataGridTextColumn x:Name="TypeColumn" ElementStyle="{StaticResource FileColumnText}" Header="유형" Binding="{Binding Type}" SortMemberPath="Type" Width="95" Visibility="Collapsed"/>
<DataGridTextColumn x:Name="CreatedColumn" ElementStyle="{StaticResource FileColumnText}" Header="만든 날짜" Binding="{Binding Created, StringFormat=yy.MM.dd HH:mm}" SortMemberPath="Created" Width="Auto" Visibility="Collapsed"/>
<DataGridTextColumn x:Name="ExtensionColumn" ElementStyle="{StaticResource FileColumnText}" Header="확장명" Binding="{Binding Extension}" SortMemberPath="Extension" Width="65" Visibility="Collapsed"/>
      </DataGrid.Columns>
     </DataGrid>
     <Button Content="★ 파일 열기" Command="{Binding OpenExternal}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding State.IsFile, Converter={StaticResource BoolVisibility}}"/>
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource FontSize10}" Margin="2,3,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
   </Grid>
   
   <Border x:Name="TransferOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource CardRadius}">
    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="8,4" Margin="6"><TextBlock x:Name="TransferHint" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"/></Border>
   </Border>
  </Grid>
 </Border>
</UserControl>





















