    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True" IsOpen="{Binding Search.Visible}"><Border x:Name="SearchResultsPanel" Width="{Binding ActualWidth, ElementName=SearchBox}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid x:Name="SearchResultsLayout" Height="300">
