      <TextBlock Grid.Row="1" Text="{Binding Index.StatusDetails}" FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
