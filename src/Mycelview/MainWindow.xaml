     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="{DynamicResource FontSize10}"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="2,0"/></Style></StackPanel.Resources><Button x:Name="RegisterSearchButton" Content="선택 결과 등록 →" Click="RegisterSearchSelection"/><Button Content="원본 위치 열기" Click="SearchLocation"/><Button Content="결과 더 보기" Command="{Binding Search.LoadMore}" Visibility="{Binding Search.More, Converter={StaticResource BoolVisibility}}"/><Button Content="결과 닫기" Command="{Binding Search.Close}"/></StackPanel><TextBlock FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Search.Scope}"><Run Text="{Binding Search.Status, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding Search.Scope, Mode=OneWay}"/></TextBlock></DockPanel>
     <DataGrid x:Name="SearchResults" Sorting="SortSearchResults" Grid.Row="2" ItemsSource="{Binding Search.Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" RowHeight="{DynamicResource FileRowHeight}" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="SearchOpen" KeyDown="SearchResultKeyDown" PreviewMouseLeftButtonDown="SearchMouseDown" PreviewMouseMove="SearchMouseMove">
