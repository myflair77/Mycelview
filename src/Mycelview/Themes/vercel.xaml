<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="CanvasBrush" Color="#FAFAFA"/>
<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="BorderBrush" Color="#EBEBEB"/>
<SolidColorBrush x:Key="TextBrush" Color="#171717"/>
<SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
<SolidColorBrush x:Key="AccentBrush" Color="#171717"/>
<SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0"/>
<SolidColorBrush x:Key="SelectionBrush" Color="#EBEBEB"/>
<CornerRadius x:Key="CardRadius">6</CornerRadius>
<CornerRadius x:Key="ButtonRadius">6</CornerRadius>
<FontFamily x:Key="UiFont">Geist Sans, Inter, Segoe UI, Malgun Gothic</FontFamily>
<FontFamily x:Key="MetadataFont">Geist Mono, Consolas, Malgun Gothic</FontFamily>
<FontWeight x:Key="HeadingWeight">Normal</FontWeight>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EBEBEB"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#171717"/>
 <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}">
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.55"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
